{
  "manifest_version": 3,
  "name": "Шахматный тренер для lichess",
  "version": "1.0.0",
  "description": "Тренер в реальном времени: модель мышления перед ходом, постепенные подсказки, разбор каждого хода и курс уроков.",
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*"],
      "js": ["content/lichess.js"],
      "css": ["content/lichess.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/*"],
      "matches": ["https://lichess.org/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
